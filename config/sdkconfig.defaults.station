# AkvaLink Wi-Fi station variant (--station) — join home Wi-Fi as a client,
# provisioned over BLE (Espressif Unified Provisioning), page at akvalink.local.
#
# Layer on top of the base defaults:
#   idf.py -DSDKCONFIG_DEFAULTS="config/sdkconfig.defaults;config/sdkconfig.defaults.station" reconfigure
# or via the launcher:  akvalink.cmd --station --rebuild
#
# NO Matter, NO hub. BLE is used ONCE to hand over Wi-Fi credentials (via the
# free "ESP BLE Provisioning" app), then the radio is freed. See
# main/station_web.cpp.
#
# POWER: staying associated keeps the Wi-Fi radio reachable — lighter than the
# SoftAP variant but still not multi-year on a coin cell. Intended for mains/USB
# or a generous battery; Wi-Fi 6 TWT tuning is a future power task.

# Select the station app path (main/Kconfig.projbuild).
CONFIG_AKVALINK_STATION=y

# No Matter network stacks.
CONFIG_OPENTHREAD_ENABLED=n
CONFIG_OPENTHREAD_MTD=n
CONFIG_OPENTHREAD_SRP_CLIENT=n
CONFIG_OPENTHREAD_DNS_CLIENT=n
CONFIG_OPENTHREAD_JOINER=n

# BLE is needed for provisioning (hand over Wi-Fi credentials once). Use NimBLE
# (lighter than Bluedroid); CHIPoBLE stays off since there is no Matter here.
#
# EXT_ADV stays OFF here (unlike --ble). This IDF's vendored NimBLE hard-
# disables the legacy ble_gap_adv_set_fields()/set_data()/start() API (always
# returns BLE_HS_ENOTSUP, rc=8) whenever BLE_EXT_ADV=y — there's no legacy-
# over-ext-adv compat shim like upstream mynewt-nimble has. protocomm_nimble.c
# (wifi_prov_mgr's BLE transport) only ever calls the legacy API, so EXT_ADV=y
# here permanently breaks BLE provisioning. main/ble_gatt.cpp's escape hatch
# (GPIO9 at boot) uses the plain legacy adv API too when EXT_ADV=n (see the
# #if CONFIG_BT_NIMBLE_EXT_ADV branch in ble_gatt.cpp) — same as ble_escape.cpp
# does for --ap. Coded PHY rotation isn't available in this mode (that needs
# EXT_ADV — see --ble), but --station's escape hatch doesn't need long range.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_ENABLE_CHIPOBLE=n
CONFIG_BT_NIMBLE_EXT_ADV=n
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=517

# GATT client must be compiled in: ble_gatt.cpp (the escape-hatch GATT server)
# calls ble_gattc_exchange_mtu() on connect. That needs BT_NIMBLE_GATT_CLIENT,
# which `depends on BT_NIMBLE_ROLE_CENTRAL` — off by default in the base
# defaults for the Matter-only variants. Override both back on here.
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_GATT_CLIENT=y

# Wi-Fi: station on; no SoftAP (the device joins an existing network).
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n

# HTTP server needs more LWIP sockets than the Thread-tuned base (8): httpd uses
# a listen + control socket + several client sockets. With only 8, httpd_start()
# fails and no page is served.
CONFIG_LWIP_MAX_SOCKETS=16

# POWER: ESP-IDF officially supports automatic light sleep with an associated
# Wi-Fi station, so keep the base defaults' PM enabled here too (CPU +
# peripherals power down between Wi-Fi wakeups; the Wi-Fi driver's own
# APB-freq lock keeps timing-critical windows at full speed). Reachability
# over mDNS is unaffected — modem sleep already handled that independently.
