# AkvaLink e-ink display receiver — boot-only scaffold, no driver yet.
# No Matter, no BLE, no sensor task. See docs/EINK_DISPLAY_PLAN.md.
#
#   akvalink.cmd --display --rebuild
#
# build.sh passes -DAKVALINK_NO_MATTER=1 so the root CMakeLists skips the whole
# esp-matter stack (otherwise its NetworkCommissioning static_assert fails when
# no Thread/Wi-Fi transport is enabled).

CONFIG_AKVALINK_DISPLAY=y

# Strip every radio stack — nothing to commission or provision yet.
CONFIG_OPENTHREAD_ENABLED=n
CONFIG_OPENTHREAD_MTD=n
CONFIG_ENABLE_WIFI_STATION=n
CONFIG_ENABLE_CHIPOBLE=n
CONFIG_BT_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=n
